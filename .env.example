# =============================================================================
# Concierge Go — environment configuration
#
# Copy to .env.local for local development:   cp .env.example .env.local
# Never commit .env.local. Never put real credentials in this file.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------
# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses Row Level Security — never prefix with NEXT_PUBLIC_,
# never import into a client component, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Payments
# -----------------------------------------------------------------------------
# mock     = development flow, no money moves, clearly labelled in the UI
# paystack = real Paystack checkout (requires the keys below)
PAYMENT_MODE=mock

# https://dashboard.paystack.com/#/settings/developers
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# -----------------------------------------------------------------------------
# AI task interpretation (optional)
# -----------------------------------------------------------------------------
# deterministic = built-in rules parser, no API key needed (default)
# anthropic     = Claude API, requires AI_API_KEY
# deepseek      = DeepSeek API, requires DEEPSEEK_API_KEY
# openrouter    = OpenRouter API, requires OPENROUTER_API_KEY
AI_PROVIDER=deterministic
AI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# Optional override. DeepSeek defaults to deepseek-v4-flash.
AI_MODEL=
# Optional OpenRouter model overrides.
OPENROUTER_CHAT_MODEL=openrouter/free
OPENROUTER_DRAFT_MODEL=nex-agie/nex-n2.5-pro:free

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Used for payment callbacks, password-reset links and Open Graph URLs.
# Locally: http://localhost:3000   On Vercel: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Where operations can be reached (shown on the public site).
NEXT_PUBLIC_SUPPORT_PHONE=+2347065582830
NEXT_PUBLIC_SUPPORT_EMAIL=hello@conciergego.ng

# -----------------------------------------------------------------------------
# Outbound notification channels (optional — abstracted behind services/)
# Leave blank and notifications stay in-app only.
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# -----------------------------------------------------------------------------
# Seeding (npm run seed) — demo accounts share this password.
# Development only.
# -----------------------------------------------------------------------------
SEED_PASSWORD=ConciergeGo!2026
SEED_ADMIN_EMAIL=ops@conciergego.test
